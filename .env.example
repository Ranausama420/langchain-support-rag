# Offline demo uses deterministic lexical hash embeddings, NOT a semantic model.
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL=
CHROMA_PERSIST_DIRECTORY=./data/chroma
MANUALS_DIRECTORY=./examples/manuals
RUNS_DIRECTORY=./data/runs
TOP_K=4
MIN_SIMILARITY=0.15
CHUNK_SIZE=900
CHUNK_OVERLAP=120
# Aliases are public labels; models/deployments are selected by the operator.
MODELS_JSON=[{"alias":"demo","provider":"demo","model":"extractive-v1"}]
DEFAULT_MODEL=demo
MODEL_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI and Ollama embeddings supported; demo needs no key or downloads.
# Azure key authentication is used in this release.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-rag
# Detailed disk traces contain questions and passages; off by default.
STORE_TRACE_CONTENT=false
